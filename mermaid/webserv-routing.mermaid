---
title: webserv — Routing a complete request (handleRequest)
---

%%{init: {"theme": "dark"}}%%

%% =====================================================================
%% This kicks in AFTER HttpRequest reports COMPLETE.
%% Server::handleRequest(c) lives in src/server/Server.cpp.
%%
%% It answers: "the browser asked for X — what bytes do I send back?"
%%   • redirect?            301 / 302 Location header
%%   • GET a file/dir?      serveFile / serveDirectory / 404
%%   • POST upload?         write to ./www/uploads/<name>
%%   • DELETE upload?       remove ./www/uploads/<name>
%%   • anything else?       405 or 501
%%
%% End state is always the same: an HttpResponse is built, serialized
%% into Connection.writeBuf, and the Connection flips to
%% WRITING_RESPONSE. The poll() loop takes it from there.
%% =====================================================================

flowchart TD

    in(["Request complete<br/>method · uri · headers · body filled in"]):::start

    in --> strip["Split URI at the first '?'<br/>pathPart = before '?'<br/>(query stays in uri, used later by CGI)"]

    strip --> red1{"pathPart == /old-page ?"}
    red1 -- yes --> r301["buildRedirect(301, '/')<br/>‘Moved Permanently’<br/><br/>NOTE: hardcoded demo —<br/>real redirects will come from the<br/>config file (planned)"]:::planned
    red1 -- no  --> red2{"pathPart == /redirect-me ?"}
    red2 -- yes --> r302["buildRedirect(302, '/')<br/>‘Found’ (temporary)<br/><br/>also hardcoded for demo"]:::planned
    red2 -- no  --> method{"which method?"}

    %% ───────── GET ─────────
    subgraph GET_FLOW["GET — serve a file or directory"]
        direction TB
        g1["resolvePath(uri):<br/>1. drop query string<br/>2. percentDecode (%20 → space, etc.)<br/>3. split on '/', drop '.' and pop on '..'<br/>4. prepend _docRoot (./www)"]
        g2{"path empty?"}
        g3{"isPathSafe(_docRoot, path)?<br/>(still starts with ./www —<br/>blocks ../../etc/passwd tricks)"}
        g4["stat(path)"]
        g5{"exists?"}
        g6{"S_ISDIR?"}
        g7{"URI ends with '/'?"}
        g8["buildRedirect(301, pathPart + '/')<br/>so relative links inside resolve correctly"]
        g9{"./index.html exists<br/>(and is a regular file)?"}
        sFile["serveFile(path)<br/>open(O_RDONLY) + read whole file<br/>(disk is exempt from poll)<br/>Content-Type from extension<br/>200 OK"]:::ok
        sFile2["serveFile(index.html)<br/>200 OK"]:::ok
        sDir["serveDirectory(dirPath, uri)<br/>opendir + readdir loop<br/>build autoindex HTML<br/>(NOTE: should be a per-route<br/>on/off switch from config — planned)<br/>200 OK"]:::ok

        g1 --> g2
        g2 -- yes --> ERR_400_a["400 Bad Request"]:::err
        g2 -- no  --> g3
        g3 -- no  --> ERR_403_a["403 Forbidden<br/>(path traversal blocked)"]:::err
        g3 -- yes --> g4 --> g5
        g5 -- no  --> ERR_404["404 Not Found"]:::err
        g5 -- yes --> g6
        g6 -- no  --> sFile
        g6 -- yes --> g7
        g7 -- no  --> g8
        g7 -- yes --> g9
        g9 -- yes --> sFile2
        g9 -- no  --> sDir
    end

    %% ───────── POST ─────────
    subgraph POST_FLOW["POST — upload a file"]
        direction TB
        p1{"pathPart starts with /uploads/ ?<br/>(only /uploads/* accepts POST today —<br/>real per-route config: planned)"}
        p2["handleUpload(c)<br/>filename = pathPart after '/uploads/'<br/>(percent-decoded)"]
        p3{"filename empty,<br/>contains '..' or '/' ?"}
        p4["open(_uploadDir+'/'+filename,<br/>O_WRONLY | O_CREAT | O_TRUNC, 0644)"]
        p5{"open failed?"}
        p6["write body bytes in a loop<br/>(body is already un-chunked<br/>by HttpRequest)"]
        p7{"write failed?"}
        p8["HttpResponse 201 Created<br/>application/json<br/>{status: uploaded, file, size}"]:::ok

        p1 -- no  --> ERR_405_a["405 Method Not Allowed"]:::err
        p1 -- yes --> p2 --> p3
        p3 -- yes --> ERR_400_b["400 Bad Request"]:::err
        p3 -- no  --> p4 --> p5
        p5 -- yes --> ERR_500_a["500 Internal Server Error"]:::err
        p5 -- no  --> p6 --> p7
        p7 -- yes --> ERR_500_b["500 Internal Server Error"]:::err
        p7 -- no  --> p8
    end

    %% ───────── DELETE ─────────
    subgraph DEL_FLOW["DELETE — remove an uploaded file"]
        direction TB
        d1{"pathPart starts with /uploads/ ?"}
        d2["handleDeleteMethod(c)<br/>filename = pathPart after '/uploads/'<br/>(percent-decoded)"]
        d3{"filename empty,<br/>contains '..' or '/' ?"}
        d4["stat the file"]
        d5{"missing?"}
        d6{"not a regular file?"}
        d7["std::remove(fullPath)"]
        d8{"remove failed?"}
        d9["HttpResponse 200 OK<br/>application/json<br/>{status: deleted, file}"]:::ok

        d1 -- no  --> ERR_405_b["405 Method Not Allowed"]:::err
        d1 -- yes --> d2 --> d3
        d3 -- yes --> ERR_400_c["400 Bad Request"]:::err
        d3 -- no  --> d4 --> d5
        d5 -- yes --> ERR_404_b["404 Not Found"]:::err
        d5 -- no  --> d6
        d6 -- yes --> ERR_403_b["403 Forbidden"]:::err
        d6 -- no  --> d7 --> d8
        d8 -- yes --> ERR_500_c["500 Internal Server Error"]:::err
        d8 -- no  --> d9
    end

    method -- GET    --> g1
    method -- POST   --> p1
    method -- DELETE --> d1
    method -- "HEAD, PUT, PATCH, ..." --> ERR_501["501 Not Implemented"]:::err

    %% ───────── Planned CGI branch ─────────
    method -. "planned: if URI matches a CGI extension<br/>(.py, .php, ...) → dispatch to CgiHandler<br/>see webserv-cgi.mermaid" .-> CGI["CgiHandler.start(...)<br/>(stubbed today)"]:::planned

    %% ───────── Final convergence ─────────
    sFile  --> finish
    sFile2 --> finish
    sDir   --> finish
    r301   --> finish
    r302   --> finish
    g8     --> finish
    p8     --> finish
    d9     --> finish

    ERR_400_a --> errFinish
    ERR_400_b --> errFinish
    ERR_400_c --> errFinish
    ERR_403_a --> errFinish
    ERR_403_b --> errFinish
    ERR_404   --> errFinish
    ERR_404_b --> errFinish
    ERR_405_a --> errFinish
    ERR_405_b --> errFinish
    ERR_500_a --> errFinish
    ERR_500_b --> errFinish
    ERR_500_c --> errFinish
    ERR_501   --> errFinish

    errFinish["buildErrorResponse(code)<br/>HttpResponse::defaultErrorBody(code)<br/>Connection: close (no keep-alive on errors)<br/><br/>NOTE: custom error pages from config: planned"]:::errfin
    errFinish --> finish

    finish(["HttpResponse built · serialize() bytes →<br/>Connection.writeBuf · bytesSent = 0<br/>Connection state = WRITING_RESPONSE<br/>poll() now watches POLLOUT on this fd"]):::done

    classDef start   fill:#0e2a1d,stroke:#33aa66,color:#aaffcc
    classDef done    fill:#0e1a3a,stroke:#33aaff,color:#aaccff
    classDef ok      fill:#13301e,stroke:#33aa66,color:#aaffcc
    classDef err     fill:#3a1a1a,stroke:#cc6633,color:#ffccaa
    classDef errfin  fill:#3a1a1a,stroke:#cc6633,color:#ffccaa
    classDef planned stroke-dasharray: 5 5,stroke:#aa66ff,color:#cba6ff
