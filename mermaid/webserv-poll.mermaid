---
title: webserv — Why one poll() loop, not threads
---

%%{init: {"theme": "dark"}}%%

%% =====================================================================
%% This diagram explains the single most important rule of webserv:
%%
%%   ONE thread, ONE poll() call, NEVER block.
%%
%% If you understand this, you understand 80%% of why the project is
%% structured the way it is. Everything else (the parser being
%% incremental, Connection holding read/write buffers, POLLIN ⇆ POLLOUT
%% flipping) exists to serve this one rule.
%% =====================================================================

flowchart TB

    %% ── Why this exists ──────────────────────────────────────────
    subgraph WHY["Why this design (the subject demands it)"]
        direction TB
        w1["A blocking read() waits forever for one client.<br/>While it waits, ALL other clients freeze.<br/>That's a single slow phone unplugging your whole house."]
        w2["Fix: every socket is non-blocking<br/>(fcntl F_SETFL, O_NONBLOCK).<br/>Then we ask the kernel ONE question per loop:<br/>‘which of these fds is ready right now?’<br/>That's what poll() does."]
        w3["So: one thread, one poll(), one ‘to-do list’ of fds.<br/>fork() is forbidden except for CGI."]
        w1 --> w2 --> w3
    end

    %% ── The actual loop in Server::run() ─────────────────────────
    subgraph LOOP["Server::run() — the loop body"]
        direction TB
        l1(["start: build a Server,<br/>addListener registered ports"]):::start
        l2["poll(_fds, len, 1000 ms)<br/>‘kernel, wake me when any of these fds<br/>becomes ready — or in 1 second, whichever first’"]
        l3{"poll returned what?"}
        l3t["timeout (no fd ready)"]
        l3e["error (-1)"]
        l3o["≥ 1 fd ready"]

        l4["snapshot _fds, then<br/>for each pollfd { fd, revents } in the snapshot"]

        l5{"revents == 0?<br/>(nothing happened on this fd)"}
        l6{"is it a listen socket?<br/>(in _listeners)"}
        l7["acceptNewClient(fd)<br/>• accept() → new client fd<br/>• fcntl O_NONBLOCK<br/>• _conns[cfd] = Connection(cfd)<br/>• addFd(cfd, POLLIN)"]
        l8{"POLLHUP / POLLERR / POLLNVAL?<br/>(client died or fd is bad)"}
        l9["closeConnection(fd)<br/>close(fd); _conns.erase; removeFd"]
        l10{"POLLIN?<br/>(can read without blocking)"}
        l11["handleReadable(fd)<br/>• recv up to 4096 bytes<br/>• HttpRequest::feed(buf, n)<br/>• if complete → handleRequest<br/>• flip events to POLLOUT"]
        l12{"POLLOUT?<br/>(can write without blocking)"}
        l13["handleWritable(fd)<br/>• send() bytes from writeBuf+bytesSent<br/>• if all bytes sent:<br/>  – keep-alive → flip back to POLLIN<br/>  – else closeConnection(fd)"]
        l14["checkTimeouts()<br/>any conn idle > 30 s → closeConnection<br/>(prevents ‘request never ends’)"]
        l15(["back to poll()"]):::loopback

        l1 --> l2 --> l3
        l3 --> l3t --> l14
        l3 --> l3e --> br_err["log + break (shut down)"]:::err
        l3 --> l3o --> l4
        l4 --> l5
        l5 -- yes --> l14
        l5 -- no --> l6
        l6 -- yes --> l7 --> l14
        l6 -- no --> l8
        l8 -- yes --> l9 --> l14
        l8 -- no --> l10
        l10 -- yes --> l11 --> l12
        l10 -- no --> l12
        l12 -- yes --> l13 --> l14
        l12 -- no --> l14
        l14 --> l15 --> l2
    end

    %% ── What's actually in the poll set ──────────────────────────
    subgraph FDS["What lives in _fds (the poll set)"]
        direction TB
        f1["listen sockets<br/>(_listeners — 9090, 9091)<br/>events: POLLIN always<br/>‘knock-on-the-door’ detector"]
        f2["client sockets<br/>(_conns map, one per browser)<br/>events flip:<br/>  POLLIN  while reading the request<br/>  POLLOUT while sending the response<br/>setPollEvents(fd, ...) does the flip"]
        f3["CGI pipe fds<br/>(planned)<br/>stdinFd → POLLOUT (parent writes body)<br/>stdoutFd → POLLIN (parent reads output)<br/>added on start(), removed on DONE/FAILED"]:::planned
    end

    %% ── Subject rules this design enforces ───────────────────────
    subgraph RULES["Subject rules — break these and grade = 0"]
        direction TB
        r1["• You may ONLY call read/recv/write/send<br/>  after poll() said the fd is ready.<br/>  No errno-driven retry, no EAGAIN logic."]
        r2["• poll() must watch read AND write<br/>  readiness simultaneously."]
        r3["• Regular disk files are the ONLY exception —<br/>  open/read/write them directly.<br/>  See serveFile() reading ./www files."]
        r4["• fork() is allowed ONLY for CGI<br/>  (this is why CgiHandler exists)."]
        r5["• Never crash. The server runs forever,<br/>  a request never hangs forever<br/>  (that's what the 30 s idle timeout is for)."]
    end

    classDef start    fill:#0e2a1d,stroke:#33aa66,color:#aaffcc
    classDef loopback fill:#1a1a3a,stroke:#7c5cfc,color:#cba6ff
    classDef err      fill:#331111,stroke:#cc6633,color:#ffccaa
    classDef planned  stroke-dasharray: 5 5,stroke:#aa66ff,color:#cba6ff
    class f3 planned
